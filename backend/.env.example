NODE_ENV=development
PORT=3001

# Comma-separated list of allowed frontend origins
# Development: http://localhost:5173
# Production example: https://yourdomain.com,https://www.yourdomain.com
# Vercel deployments are automatically allowed (*.vercel.app)
FRONTEND_URL=http://localhost:5173

# JWT — MUST be changed to a long random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-super-secret-key-in-production
JWT_EXPIRES_IN=7d

# SQLite DB path (relative to where the process runs)
# Railway automatically provides a persistent volume via RAILWAY_VOLUME_MOUNT_PATH
DB_PATH=devtoolkit.sqlite
